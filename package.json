{
  "name": "dsa-mastery",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "content": "node scripts/build-content.mjs",
    "content:check": "node scripts/build-content.mjs --check",
    "verify:supabase": "node scripts/verify-supabase.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:sync": "node scripts/verify-sync.mjs",
    "test:merge": "node scripts/test-merge.mjs",
    "test:dates": "node scripts/test-dates.mjs",
    "test": "node scripts/test-merge.mjs && node scripts/test-dates.mjs && node scripts/build-content.mjs --check",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "expo": "~51.0.0",
    "expo-router": "~3.5.0",
    "expo-constants": "~16.0.0",
    "expo-linking": "~6.3.0",
    "expo-status-bar": "~1.12.0",
    "expo-notifications": "~0.28.0",
    "expo-font": "~12.0.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "zustand": "^4.5.0",
    "expo-splash-screen": "~0.27.0",
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/jetbrains-mono": "^0.2.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "typescript": "~5.3.0",
    "@types/react": "~18.2.0"
  },
  "private": true
}
