# Copy to .env and fill in from your Supabase project.
# Supabase dashboard -> your project -> Settings -> API
#
# .env is gitignored. Never commit real keys. For EAS builds these go in
# EAS secrets (M7), not in the repo.
#
# The anon key is a public, client-side key — it is safe to ship in an app
# binary. Row-level security (supabase/schema.sql) is what protects user data.
# The service_role key is NOT safe and must never appear in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
